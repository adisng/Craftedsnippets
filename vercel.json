{
  "version": 2,
  "builds": [
    {
      "src": "artifacts/craftedsnippets/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist/public"
      }
    },
    {
      "src": "api/index.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/index.ts"
    },
    {
      "src": "/(.*)",
      "dest": "artifacts/craftedsnippets/$1"
    }
  ]
}
